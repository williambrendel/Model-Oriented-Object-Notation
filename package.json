{
  "name": "moon-format",
  "version": "0.1.0",
  "description": "MOON (Model-Oriented Object Notation) — a compact, schema-first serialization format built for LLM input. Take TOON to the MOON.",
  "main": "src/index.js",
  "scripts": {
    "clear-all": "rm -rf node_modules/ && npm cache clean --force",
    "docs": "npx documentation build src/**/*.js -f html -o docs",
    "docs:watch": "npx documentation build src/**/*.js -f html -o docs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lintdiff": "git diff --name-only --cached --relative | grep '\\.js$' | xargs standard | snazzy",
    "verbose-test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose --silent=false",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --silent=false",
    "update": "npx npm-check-updates -u; npm update; npm install"
  },
  "keywords": [
    "moon",
    "moon-format",
    "toon",
    "llm",
    "serialization",
    "prompt",
    "schema",
    "token-efficient"
  ],
  "author": "William Brendel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/williambrendel/Model-Oriented-Object-Notation"
  },
  "homepage": "https://github.com/williambrendel/Model-Oriented-Object-Notation#readme",
  "bugs": {
    "url": "https://github.com/williambrendel/Model-Oriented-Object-Notation/issues"
  },
  "devDependencies": {
    "@eslint/create-config": "latest",
    "@eslint/js": "latest",
    "@jest/globals": "latest",
    "documentation": "^14.0.3",
    "eslint": "latest",
    "eslint-plugin-json": "latest",
    "globals": "latest",
    "jest": "latest",
    "npm-check-updates": "latest"
  }
}